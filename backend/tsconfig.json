{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "outDir": "..\\dist",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": false,
    "declaration": false
  },
  "include": ["**/*.ts", "**/*.tsx", "../types/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
